<section class="grid gap-6 xl:grid-cols-3">
  <div class="space-y-6 xl:col-span-2">
    <% if (!accounts.length) { %>
      <div class="card">
        <p class="empty-state">No accounts yet. Add your first account using the form.</p>
      </div>
    <% } else { %>
      <div class="grid gap-4 sm:grid-cols-2">
        <% accounts.forEach(function (account) { %>
          <article class="card">
            <div class="flex items-start justify-between gap-3">
              <div class="flex min-w-0 items-center gap-3">
                <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl text-white" style="background-color: <%= account.colour %>">
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 7h18v10H3zM3 10h18M7 14h3"/>
                  </svg>
                </span>
                <div class="min-w-0">
                  <h2 class="truncate font-semibold text-slate-900"><%= account.name %></h2>
                  <p class="text-xs capitalize text-slate-500"><%= account.type %> account</p>
                </div>
              </div>
              <span class="badge capitalize" style="background-color: <%= account.colour %>1a; color: <%= account.colour %>"><%= account.type %></span>
            </div>

            <p class="mt-4 text-2xl font-bold <%= Number(account.balance_cents) < 0 ? 'text-rose-700' : 'text-slate-900' %>"><%= money(account.balance_cents) %></p>
            <p class="text-xs text-slate-500">
              Opening balance <%= money(account.opening_balance_cents) %> &middot;
              <%= account.transaction_count %> transaction<%= Number(account.transaction_count) === 1 ? '' : 's' %>
            </p>

            <div class="mt-4 flex items-center gap-2 border-t border-slate-200 pt-4">
              <a href="/accounts/<%= account.id %>/edit" class="btn-secondary btn-xs">Edit</a>
              <form method="post" action="/accounts/<%= account.id %>/delete" data-confirm="Delete this account? Accounts with transactions cannot be removed.">
                <button type="submit" class="btn-danger btn-xs">Delete</button>
              </form>
              <a href="/transactions?account=<%= account.id %>" class="ml-auto text-xs font-semibold text-brand-700 hover:text-brand-800">View transactions</a>
            </div>
          </article>
        <% }); %>
      </div>
    <% } %>
  </div>

  <aside class="card h-fit">
    <div class="card-header">
      <div>
        <h2 class="card-title">Add an account</h2>
        <p class="card-subtitle">Current, savings, credit or cash</p>
      </div>
    </div>

    <form method="post" action="/accounts" novalidate class="space-y-4">
      <div>
        <label for="account-name" class="label">Name</label>
        <input id="account-name" name="name" type="text" class="input <%= errors.name ? 'input-error' : '' %>" value="<%= values.name %>" maxlength="40" placeholder="e.g. Holiday Savings" required>
        <% if (errors.name) { %><p class="error-text"><%= errors.name %></p><% } %>
      </div>

      <div>
        <label for="account-type" class="label">Type</label>
        <select id="account-type" name="type" class="select <%= errors.type ? 'input-error' : '' %>" required>
          <% ['current', 'savings', 'credit', 'cash'].forEach(function (type) { %>
            <option value="<%= type %>" <%= values.type === type ? 'selected' : '' %>><%= type.charAt(0).toUpperCase() + type.slice(1) %></option>
          <% }); %>
        </select>
        <% if (errors.type) { %><p class="error-text"><%= errors.type %></p><% } %>
      </div>

      <div>
        <label for="account-balance" class="label">Opening balance (EUR)</label>
        <input id="account-balance" name="opening_balance" type="text" inputmode="decimal" class="input <%= errors.openingBalance ? 'input-error' : '' %>" value="<%= values.openingBalance %>" placeholder="0.00">
        <% if (errors.openingBalance) { %><p class="error-text"><%= errors.openingBalance %></p><% } %>
        <p class="mt-1 text-xs text-slate-500">Use a negative value for money owed, such as a credit card.</p>
      </div>

      <div>
        <label for="account-colour" class="label">Colour</label>
        <div class="flex items-center gap-3">
          <input id="account-colour" name="colour" type="color" class="h-10 w-14 cursor-pointer rounded-lg border border-slate-300 bg-white p-1" value="<%= values.colour %>">
          <span class="text-xs text-slate-500">Used for badges and charts.</span>
        </div>
        <% if (errors.colour) { %><p class="error-text"><%= errors.colour %></p><% } %>
      </div>

      <button type="submit" class="btn-primary w-full">Add account</button>
    </form>
  </aside>
</section>
