<section class="card max-w-3xl">
  <div class="card-header">
    <div>
      <h2 class="card-title"><%= mode === 'create' ? 'New transaction' : 'Edit transaction' %></h2>
      <p class="card-subtitle">All fields are validated on the server before anything is saved.</p>
    </div>
  </div>

  <form method="post" action="<%= action %>" novalidate class="space-y-5">
    <fieldset>
      <legend class="label">Type</legend>
      <div class="flex flex-wrap gap-2">
        <label class="radio-card">
          <input type="radio" name="type" value="expense" <%= values.type === 'expense' ? 'checked' : '' %> data-type-option>
          <span>Expense</span>
        </label>
        <label class="radio-card">
          <input type="radio" name="type" value="income" <%= values.type === 'income' ? 'checked' : '' %> data-type-option>
          <span>Income</span>
        </label>
      </div>
      <% if (errors.type) { %><p class="error-text"><%= errors.type %></p><% } %>
    </fieldset>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label for="transaction_date" class="label">Date</label>
        <input id="transaction_date" name="transaction_date" type="date" class="input <%= errors.transactionDate ? 'input-error' : '' %>" value="<%= values.transactionDate %>" max="<%= today %>" min="2000-01-01" required>
        <% if (errors.transactionDate) { %><p class="error-text"><%= errors.transactionDate %></p><% } %>
      </div>
      <div>
        <label for="amount" class="label">Amount (EUR)</label>
        <div class="relative">
          <span class="pointer-events-none absolute inset-y-0 left-3 grid place-items-center text-sm font-semibold text-slate-400">&euro;</span>
          <input id="amount" name="amount" type="text" inputmode="decimal" class="input pl-8 <%= errors.amount ? 'input-error' : '' %>" value="<%= values.amount %>" placeholder="0.00" required>
        </div>
        <% if (errors.amount) { %><p class="error-text"><%= errors.amount %></p><% } %>
      </div>
    </div>

    <div>
      <label for="description" class="label">Description</label>
      <input id="description" name="description" type="text" class="input <%= errors.description ? 'input-error' : '' %>" value="<%= values.description %>" maxlength="120" placeholder="e.g. Weekly grocery shop" required>
      <% if (errors.description) { %><p class="error-text"><%= errors.description %></p><% } %>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label for="account_id" class="label">Account</label>
        <select id="account_id" name="account_id" class="select <%= errors.accountId ? 'input-error' : '' %>" required>
          <option value="">Choose an account</option>
          <% accounts.forEach(function (account) { %>
            <option value="<%= account.id %>" <%= Number(values.accountId) === Number(account.id) ? 'selected' : '' %>><%= account.name %></option>
          <% }); %>
        </select>
        <% if (errors.accountId) { %><p class="error-text"><%= errors.accountId %></p><% } %>
      </div>
      <div>
        <label for="category_id" class="label">Category</label>
        <select id="category_id" name="category_id" class="select <%= errors.categoryId ? 'input-error' : '' %>" required>
          <option value="">Choose a category</option>
          <% categories.forEach(function (category) { %>
            <option value="<%= category.id %>" data-kind="<%= category.kind %>" <%= Number(values.categoryId) === Number(category.id) ? 'selected' : '' %>><%= category.name %> (<%= category.kind %>)</option>
          <% }); %>
        </select>
        <% if (errors.categoryId) { %><p class="error-text"><%= errors.categoryId %></p><% } %>
        <p class="mt-1 text-xs text-slate-500">Only categories that match the selected type are shown.</p>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2 border-t border-slate-200 pt-5">
      <button type="submit" class="btn-primary"><%= mode === 'create' ? 'Add transaction' : 'Save changes' %></button>
      <a href="/transactions" class="btn-secondary">Cancel</a>
      <% if (mode === 'edit') { %>
        <button type="submit" form="deleteTransactionForm" class="btn-danger ml-auto">Delete transaction</button>
      <% } %>
    </div>
  </form>

  <% if (mode === 'edit') { %>
    <form id="deleteTransactionForm" method="post" action="<%= action %>/delete" data-confirm="Delete this transaction?"></form>
  <% } %>
</section>
