<% if (flash) { %>
  <div class="flash <%= flash.type === 'error' ? 'flash-error' : 'flash-success' %>" role="status">
    <span class="flex items-center gap-2">
      <% if (flash.type === 'error') { %>
        <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M10.3 3.9L1.8 18a2 2 0 001.7 3h17a2 2 0 001.7-3L13.7 3.9a2 2 0 00-3.4 0z"/>
        </svg>
      <% } else { %>
        <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
      <% } %>
      <%= flash.message %>
    </span>
    <button type="button" class="flash-close" data-dismiss-flash aria-label="Dismiss message">&times;</button>
  </div>
<% } %>
