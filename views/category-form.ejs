<section class="card max-w-2xl">
  <div class="card-header">
    <div>
      <h2 class="card-title">Edit category</h2>
      <p class="card-subtitle">A category used by transactions cannot switch between income and expense.</p>
    </div>
  </div>

  <form method="post" action="<%= action %>" novalidate class="space-y-5">
    <div>
      <label for="category-name" class="label">Name</label>
      <input id="category-name" name="name" type="text" class="input <%= errors.name ? 'input-error' : '' %>" value="<%= values.name %>" maxlength="40" required>
      <% if (errors.name) { %><p class="error-text"><%= errors.name %></p><% } %>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label for="category-kind" class="label">Type</label>
        <select id="category-kind" name="kind" class="select <%= errors.kind ? 'input-error' : '' %>" required>
          <option value="expense" <%= values.kind === 'expense' ? 'selected' : '' %>>Expense</option>
          <option value="income" <%= values.kind === 'income' ? 'selected' : '' %>>Income</option>
        </select>
        <% if (errors.kind) { %><p class="error-text"><%= errors.kind %></p><% } %>
      </div>
      <div>
        <label for="category-colour" class="label">Colour</label>
        <input id="category-colour" name="colour" type="color" class="h-10 w-full cursor-pointer rounded-lg border border-slate-600 bg-white p-1" value="<%= values.colour %>">
        <% if (errors.colour) { %><p class="error-text"><%= errors.colour %></p><% } %>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2 border-t border-slate-700/60 pt-5">
      <button type="submit" class="btn-primary">Save changes</button>
      <a href="/categories" class="btn-secondary">Cancel</a>
      <button type="submit" form="deleteCategoryForm" class="btn-danger ml-auto">Delete category</button>
    </div>
  </form>

  <form id="deleteCategoryForm" method="post" action="<%= action %>/delete" data-confirm="Delete this category? Categories used by transactions or budgets cannot be removed."></form>
</section>
