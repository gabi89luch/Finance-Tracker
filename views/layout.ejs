<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Finance Tracker</title>
  <meta name="description" content="Personal finance tracker built with Node.js, Express, SQLite and Chart.js.">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ["Manrope", "Inter", "ui-sans-serif", "system-ui", "sans-serif"]
          },
          colors: {
            brand: {
              50: "#f1f6f2", 100: "#dce7df", 200: "#b9d0c0", 300: "#8fb29a",
              400: "#5e8f6e", 500: "#3a6b4d", 600: "#123524", 700: "#0e2a1d",
              800: "#0a1f15", 900: "#06140e"
            },
            gold: {
              50: "#fbf6ea", 100: "#f5e9cc", 200: "#ead39a", 300: "#ddb866",
              400: "#c8a45d", 500: "#b38a3f", 600: "#956f2c", 700: "#755622",
              800: "#5a421b", 900: "#3f2e13"
            },
            slate: {
              50: "#faf9f5", 100: "#f4f1ea", 200: "#e6e1d8", 300: "#d4cec3",
              400: "#a8a095", 500: "#7a7268", 600: "#5b6b5f", 700: "#3d4a40",
              800: "#2a352d", 900: "#14231b"
            },
            rose: {
              50: "#fbf1ee", 100: "#f5e0d9", 200: "#e8c3b8", 300: "#d9a08f",
              400: "#c27a5a", 500: "#b4533a", 600: "#9a422d", 700: "#7c3424",
              800: "#60281c", 900: "#4a1f16"
            }
          },
          boxShadow: {
            card: "0 1px 2px rgba(20, 35, 27, 0.05), 0 14px 34px -16px rgba(20, 35, 27, 0.22)"
          }
        }
      }
    };
  </script>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-slate-100 text-slate-800 font-sans antialiased">
  <a href="#main" class="skip-link">Skip to content</a>

  <div class="min-h-screen lg:flex">
    <aside id="sidebar" class="sidebar" aria-label="Main navigation">
      <div class="flex items-center gap-3 px-5 py-5 border-b border-white/10">
        <span class="grid h-10 w-10 place-items-center rounded-xl bg-brand-500 text-white shadow-lg shadow-brand-900/30">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 17l6-6 4 4 8-8M14 7h7v7"/>
          </svg>
        </span>
        <div>
          <div class="text-sm font-bold text-white">Finance Tracker</div>
          <div class="text-[11px] font-medium uppercase tracking-wider text-slate-400">H6WAD Final Project</div>
        </div>
      </div>

      <nav class="flex-1 space-y-1 px-3 py-4">
        <%- include('nav-link', { href: '/', key: 'dashboard', label: 'Dashboard', active, icon: 'M3 12l9-9 9 9M5 10v10a1 1 0 001 1h4v-6h4v6h4a1 1 0 001-1V10' }) %>
        <%- include('nav-link', { href: '/transactions', key: 'transactions', label: 'Transactions', active, icon: 'M4 6h16M4 12h16M4 18h10' }) %>
        <%- include('nav-link', { href: '/budgets', key: 'budgets', label: 'Budgets', active, icon: 'M11 3v18M3 11h18M7 7h10v10H7z' }) %>
        <%- include('nav-link', { href: '/accounts', key: 'accounts', label: 'Accounts', active, icon: 'M3 7h18v10H3zM3 10h18M7 14h3' }) %>
        <%- include('nav-link', { href: '/categories', key: 'categories', label: 'Categories', active, icon: 'M4 5h6v6H4zM14 5h6v6h-6zM4 15h6v4H4zM14 15h6v4h-6z' }) %>
        <%- include('nav-link', { href: '/about', key: 'about', label: 'About', active, icon: 'M12 8h.01M11 12h1v4h1M12 3a9 9 0 100 18 9 9 0 000-18z' }) %>
      </nav>

      <div class="border-t border-white/10 p-5">
        <p class="text-xs font-semibold text-slate-300">Valentin Gabriel Luchian</p>
        <p class="mt-0.5 text-[11px] text-slate-500">Student ID 24318230</p>
      </div>
    </aside>

    <div id="sidebarBackdrop" class="sidebar-backdrop" hidden></div>

    <div class="flex min-w-0 flex-1 flex-col">
      <header class="sticky top-0 z-30 border-b border-slate-200 bg-white/90 backdrop-blur">
        <div class="mx-auto flex h-16 max-w-7xl items-center gap-3 px-4 sm:px-6 lg:px-8">
          <button id="menuToggle" type="button" class="btn-icon lg:hidden" aria-label="Open menu" aria-controls="sidebar" aria-expanded="false">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
          <div class="min-w-0 flex-1">
            <h1 class="truncate text-base font-bold text-slate-900 sm:text-lg"><%= title %></h1>
            <% if (subtitle) { %>
              <p class="truncate text-xs text-slate-500"><%= subtitle %></p>
            <% } %>
          </div>
          <a href="/transactions/new" class="btn-primary hidden sm:inline-flex">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Add transaction
          </a>
          <a href="/transactions/new" class="btn-primary btn-icon sm:hidden" aria-label="Add transaction">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
          </a>
        </div>
      </header>

      <main id="main" class="mx-auto w-full max-w-7xl flex-1 px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
        <%- include('flash') %>
        <%- body %>
      </main>

      <footer class="border-t border-slate-200 bg-white">
        <div class="mx-auto flex max-w-7xl flex-col gap-1 px-4 py-5 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
          <p>Finance Tracker - H6WAD Final Project 2026</p>
          <p>Valentin Gabriel Luchian - 24318230</p>
        </div>
      </footer>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
  <script src="/js/app.js" defer></script>
  <% if (pageScript) { %>
    <script src="/js/<%= pageScript %>" defer></script>
  <% } %>
</body>
</html>
