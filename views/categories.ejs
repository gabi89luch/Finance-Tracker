<section class="grid gap-6 xl:grid-cols-3">
  <div class="space-y-6 xl:col-span-2">
    <% ['expense', 'income'].forEach(function (kind) { %>
      <% const group = categories.filter(function (category) { return category.kind === kind; }); %>
      <div class="card">
        <div class="card-header">
          <div>
            <h2 class="card-title capitalize"><%= kind %> categories</h2>
            <p class="card-subtitle"><%= group.length %> categor<%= group.length === 1 ? 'y' : 'ies' %> used to group transactions</p>
          </div>
        </div>

        <% if (!group.length) { %>
          <p class="empty-state">No <%= kind %> categories yet.</p>
        <% } else { %>
          <ul class="divide-y divide-slate-100">
            <% group.forEach(function (category) { %>
              <li class="flex flex-wrap items-center gap-3 py-3 first:pt-0 last:pb-0">
                <span class="h-3 w-3 shrink-0 rounded-full" style="background-color: <%= category.colour %>"></span>
                <div class="min-w-0 flex-1">
                  <p class="truncate font-medium text-slate-800"><%= category.name %></p>
                  <p class="text-xs text-slate-500">
                    <%= category.transaction_count %> transaction<%= Number(category.transaction_count) === 1 ? '' : 's' %>
                    &middot; <%= money(category.total_cents) %> total
                  </p>
                </div>
                <div class="flex items-center gap-2">
                  <a href="/transactions?category=<%= category.id %>" class="btn-secondary btn-xs">View</a>
                  <a href="/categories/<%= category.id %>/edit" class="btn-secondary btn-xs">Edit</a>
                  <form method="post" action="/categories/<%= category.id %>/delete" data-confirm="Delete this category? Categories used by transactions or budgets cannot be removed.">
                    <button type="submit" class="btn-danger btn-xs">Delete</button>
                  </form>
                </div>
              </li>
            <% }); %>
          </ul>
        <% } %>
      </div>
    <% }); %>
  </div>

  <aside class="card h-fit">
    <div class="card-header">
      <div>
        <h2 class="card-title">Add a category</h2>
        <p class="card-subtitle">Keep income and expenses separate</p>
      </div>
    </div>

    <form method="post" action="/categories" novalidate class="space-y-4">
      <div>
        <label for="category-name" class="label">Name</label>
        <input id="category-name" name="name" type="text" class="input <%= errors.name ? 'input-error' : '' %>" value="<%= values.name %>" maxlength="40" placeholder="e.g. Pet care" required>
        <% if (errors.name) { %><p class="error-text"><%= errors.name %></p><% } %>
      </div>

      <div>
        <label for="category-kind" class="label">Type</label>
        <select id="category-kind" name="kind" class="select <%= errors.kind ? 'input-error' : '' %>" required>
          <option value="expense" <%= values.kind === 'expense' ? 'selected' : '' %>>Expense</option>
          <option value="income" <%= values.kind === 'income' ? 'selected' : '' %>>Income</option>
        </select>
        <% if (errors.kind) { %><p class="error-text"><%= errors.kind %></p><% } %>
      </div>

      <div>
        <label for="category-colour" class="label">Colour</label>
        <div class="flex items-center gap-3">
          <input id="category-colour" name="colour" type="color" class="h-10 w-14 cursor-pointer rounded-lg border border-slate-600 bg-white p-1" value="<%= values.colour %>">
          <span class="text-xs text-slate-500">Used in charts and badges.</span>
        </div>
        <% if (errors.colour) { %><p class="error-text"><%= errors.colour %></p><% } %>
      </div>

      <button type="submit" class="btn-primary w-full">Add category</button>
    </form>
  </aside>
</section>
