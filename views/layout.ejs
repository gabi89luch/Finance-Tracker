<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Finance Tracker</title>
  <meta name="description" content="Personal finance tracker built with Node.js, Express, SQLite and Chart.js.">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            serif: ["Playfair Display", "Georgia", "serif"],
            body: ["Lora", "Georgia", "serif"],
            sans: ["Inter", "ui-sans-serif", "system-ui", "sans-serif"]
          },
          colors: {
            brand: {
              50: "#f0f5f5", 100: "#d9e5e5", 200: "#b3cbcb", 300: "#7fa8a8",
              400: "#4d8282", 500: "#2d6262", 600: "#1B4D5C", 700: "#163d49",
              800: "#123039", 900: "#0d2228"
            },
            slate: {
              50: "#faf8f5", 100: "#f5f0e8", 200: "#e8e2d8", 300: "#d4cdc0",
              400: "#a8a090", 500: "#7a7265", 600: "#5a5348", 700: "#3d3830",
              800: "#26221c", 900: "#1a1a1a"
            },
            accent: {
              50: "#fdf5f0", 100: "#fae8dd", 200: "#f4ccb3", 300: "#e9a87a",
              400: "#dc7f45", 500: "#c4622d", 600: "#a84e22", 700: "#8a3e1c",
              800: "#6e3017", 900: "#522412"
            }
          },
          boxShadow: {
            card: "0 1px 2px rgba(23, 21, 15, 0.04), 0 8px 24px -12px rgba(23, 21, 15, 0.12)"
          }
        }
      }
    };
  </script>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-[#F5F0E8] text-slate-900 font-body antialiased">
  <a href="#main" class="skip-link">Skip to content</a>

  <header class="sticky top-0 z-30 border-b-2 border-slate-900 bg-[#F5F0E8]">
    <div class="mx-auto flex h-14 max-w-6xl items-center gap-4 px-4 sm:px-6">
      <a href="/" class="flex items-center gap-2 shrink-0">
        <span class="grid h-8 w-8 place-items-center rounded-md bg-brand-600 text-white">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 17l6-6 4 4 8-8M14 7h7v7"/>
          </svg>
        </span>
        <span class="hidden text-sm font-semibold text-slate-800 sm:inline">Finance Tracker</span>
      </a>

      <nav class="flex flex-1 items-center gap-1 overflow-x-auto">
        <a href="/" class="topnav-link <%= active === 'dashboard' ? 'topnav-active' : '' %>">Dashboard</a>
        <a href="/transactions" class="topnav-link <%= active === 'transactions' ? 'topnav-active' : '' %>">Transactions</a>
        <a href="/budgets" class="topnav-link <%= active === 'budgets' ? 'topnav-active' : '' %>">Budgets</a>
        <a href="/accounts" class="topnav-link <%= active === 'accounts' ? 'topnav-active' : '' %>">Accounts</a>
        <a href="/categories" class="topnav-link <%= active === 'categories' ? 'topnav-active' : '' %>">Categories</a>
        <a href="/about" class="topnav-link <%= active === 'about' ? 'topnav-active' : '' %>">About</a>
      </nav>

      <a href="/transactions/new" class="btn-primary btn-sm shrink-0">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        <span class="hidden sm:inline">New</span>
      </a>
    </div>
  </header>

  <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:px-6">
    <%- include('flash') %>
    <%- body %>
  </main>

  <footer class="border-t-2 border-slate-900 bg-[#F5F0E8]">
    <div class="mx-auto flex max-w-6xl flex-col gap-1 px-4 py-5 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <p>Finance Tracker - H6WAD Final Project 2026</p>
      <p>Valentin Gabriel Luchian - 24318230</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
  <script src="/js/app.js" defer></script>
  <% if (pageScript) { %>
    <script src="/js/<%= pageScript %>" defer></script>
  <% } %>
</body>
</html>